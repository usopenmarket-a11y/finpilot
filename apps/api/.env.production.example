# Copy to apps/api/.env on the Linux host. Keep this file private.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Needed for legacy HS256 tokens; leave empty if the project uses JWKS keys.
SUPABASE_JWT_SECRET=
ENCRYPTION_KEY=replace-with-64-hex-characters
CLAUDE_API_KEY=your-anthropic-api-key
LOG_LEVEL=info

# BDC production sync currently requires an Egyptian sticky-session proxy.
# Leave these empty if you do not use BDC sync.
BDC_PROXY_SERVER=
BDC_PROXY_USERNAME=
BDC_PROXY_PASSWORD=
