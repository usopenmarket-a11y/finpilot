# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=info

# BDC hosted sync: Egyptian HTTP(S) proxy with a sticky session (at least 30 min).
# Generate credentials in the provider dashboard with country Egypt selected.
# These belong ONLY on the backend, never in NEXT_PUBLIC_* variables.
# No proxy is required for local development on an Egyptian connection.
BDC_PROXY_SERVER=
BDC_PROXY_USERNAME=
BDC_PROXY_PASSWORD=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy HS256 secret for Supabase Auth access tokens sent by the frontend
# as `Authorization: Bearer <token>`. The API checks JWKS signing keys first.
# Leave blank for projects using JWKS signing keys.
SUPABASE_JWT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Encryption (for bank credentials at rest — must be a 32-byte hex string)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Claude API
CLAUDE_API_KEY=sk-ant-your-key-here
