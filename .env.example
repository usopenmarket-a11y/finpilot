# Public DNS name pointing to this Kali host. Use a hostname, without https://.
# For a local-only run with compose.local.yml, set SITE_DOMAIN=localhost.
SITE_DOMAIN=finpilot.example.com

# Public Supabase project values (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional, compose.local.yml only: loopback ports for the local run.
# LOCAL_WEB_PORT=3000
# LOCAL_API_PORT=8000

# Optional, compose.prod.existing-proxy.yml only: loopback ports for your proxy.
# WEB_BIND_PORT=13000
# API_BIND_PORT=18000
